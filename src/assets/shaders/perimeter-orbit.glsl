/** @label Sequence · 0 loop / 1 capture / 2 twin
 * @range 0, 2
 * @default 0
 */
uniform int u_sequence;
/** @label Play · 0 hold / 1 run
 * @range 0, 1
 * @default 1
 */
uniform int u_play;
/** @label Speed multiplier
 * @range 0.25, 3
 * @default 1
 */
uniform float u_speed;
/** @label Phase · seek when held / offset when running
 * @range 0, 1
 * @default 0
 */
uniform float u_phase;
/** @label Interpolation · 0 captured steps / 1 linear
 * @range 0, 1
 * @default 0
 */
uniform float u_blend;
/** @label Reverse · 0 forward / 1 backward
 * @range 0, 1
 * @default 0
 */
uniform int u_reverse;
/** @label Ink color
 * @color
 * @default #A7A7A7
 */
uniform vec3 u_ink;
/** @label Opacity
 * @range 0, 1
 * @default 1
 */
