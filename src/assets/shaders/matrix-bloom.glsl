float pulse(float age, float attack, float hold, float release) {
    return smoothstep(0.0, attack, age) * (1.0 - smoothstep(attack + hold, attack + hold + release, age));
}
float ringIndex(float r, float c) {
    if (r < 0.5) return c;
    if (r > 1.5) return 6.0 - c;
    return c > 1.5 ? 3.0 : 7.0;
}
void main() {
    vec2 pixel = floor(vec2(gl_FragCoord.x, u_resolution.y - gl_FragCoord.y));
    float scale = min(u_resolution.x, u_resolution.y) / 15.0;
    float side = max(1.0, floor(2.0 * scale + 0.5));
    float gap = max(1.0, floor(2.0 * scale + 0.5));
    float extent = 3.0 * side + 2.0 * gap;
    vec2 origin = floor((u_resolution - vec2(extent)) * 0.5);
    vec2 local = pixel - origin;
    vec2 cell = floor(local / (side + gap));
    vec2 inside = step(vec2(0.0), local) * (vec2(1.0) - step(vec2(extent), local));
    inside *= vec2(1.0) - step(vec2(side), mod(local, side + gap));
    float count = u_sequence == 1 ? 161.0 : 36.0;
    float cycle = count * 0.07;
    float phase = fract(float(u_play) * u_time * u_speed / cycle + u_phase);
    if (u_reverse == 1) phase = fract(-phase);
    float position = phase * count;
    float frame = floor(position);
    mat3 current = captured(frame);
    mat3 next = captured(mod(frame + 1.0, count));
    mat3 signal = current * (1.0 - fract(position) * u_blend) + next * (fract(position) * u_blend);
    float r = cell.y;
    float c = cell.x;
    vec3 row = r < 0.5 ? signal[0] : r < 1.5 ? signal[1] : signal[2];
    float value = c < 0.5 ? row.x : c < 1.5 ? row.y : row.z;
    if (u_sequence == 2) {
        float distance = abs(c - 1.0) + abs(r - 1.0);
        value = 0.5 + 0.5 * cos(6.28318530718 * (phase - distance / 3.0));
    } else if (u_sequence == 3) {
        value = pulse(mod(phase * 18.0 - (r + c) * 1.5, 18.0), 1.2, 2.0, 3.2);
    }
    float alpha = inside.x * inside.y * mix(u_rest, 1.0, clamp(value, 0.0, 1.0)) * u_opacity;
    // Pen shader fills require premultiplied alpha.
    gl_FragColor = vec4(u_ink * alpha, alpha);
}
