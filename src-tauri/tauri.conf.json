{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri ADE",
  "version": "0.1.0",
  "identifier": "com.upware-ops.tauri-ade",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tauri ADE",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' tauri: ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "UpWare",
    "category": "DeveloperTool",
    "shortDescription": "Agentic Development Environment PoC",
    "longDescription": "A proof of concept for an agentic development environment built with Tauri, React, and TypeScript.",
    "copyright": "Copyright © 2026 UpWare. All rights reserved.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "providerShortName": null,
      "entitlements": null,
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/upware-ops/tauri-ade/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNDA5NzUyODVDMjYwQgpSV1FMSmx3b2RRazBDU1V6ODNTb0IxbVR2TFB4a1JQNFBrdWV4Z2I1eHJWZS9ydTNmTS9ySlJ4Wgo="
    }
  }
}
